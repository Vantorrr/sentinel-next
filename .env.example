# ── Sentinel-Next Environment Variables ──────────────────────────────────────
# Copy to .env and fill in real values.

# ── Security (CRITICAL — change before deployment!) ──────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ── AI API Keys (at least one required for LLM summarization) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # optional fallback
LLM_PROVIDER=anthropic           # "anthropic" | "openai"
LLM_MODEL=claude-3-5-sonnet-20241022

# ── Inference device ──────────────────────────────────────────────────────────
YOLO_DEVICE=                     # "" (auto), "cpu", "cuda", "mps"
YOLO_MODEL=yolo11n.pt

# ── Databases ─────────────────────────────────────────────────────────────────
# Local dev — Docker Compose overrides these for container networking
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ── Hik-Connect ──────────────────────────────────────────────────────────────
# Your Hik-Connect login (same email + password as in the iPhone/Android app)
HIKCONNECT_EMAIL=
HIKCONNECT_PASSWORD=
HIKCONNECT_REGION=ru             # ru, eu, us, cn, sg, in (RU accounts use api.hik-connectru.com)

# ── Telegram alerts ─────────────────────────────────────────────────────────
# Create a bot via @BotFather, paste token here. Leave empty to disable.
TELEGRAM_BOT_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=                       # optional
DEBUG=false
DEMO_MODE=false
CORS_ORIGINS=["http://localhost:3000","https://your-domain.railway.app"]

# ── Multi-tenant ─────────────────────────────────────────────────────────────
# Default superadmin: admin@sentinel.ai / admin
# Login at /auth/login (email+password) or /auth/token (API key)
# Each salon gets its own tenant + API key (created in admin panel)

# ── Frontend (set in frontend/.env.local or as build args) ───────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events

# ── Railway Deployment ───────────────────────────────────────────────────────
# Railway auto-sets: PORT, DATABASE_URL (Postgres plugin)
# Add Redis + Qdrant via Railway plugins or external services
# Set remaining env vars in Railway dashboard
