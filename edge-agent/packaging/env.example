# Copy to the data folder as config.env and fill in. Do not commit the copy.
# Values are data. The program does not execute them.

SENTINEL_API_URL=https://your-sentinel.example
SENTINEL_API_KEY=paste-salon-api-key
SENTINEL_AGENT_ID=salon-1
SENTINEL_AGENT_NAME=Salon
SENTINEL_CAMERAS=rtsp://USER:PASSWORD@192.168.0.10:554/Streaming/Channels/102,rtsp://USER:PASSWORD@192.168.0.10:554/Streaming/Channels/202,rtsp://USER:PASSWORD@192.168.0.10:554/Streaming/Channels/302
SENTINEL_FPS_INFERENCE=5
# A bare filename is rewritten to the weights file under ProgramData on install.
SENTINEL_YOLO_MODEL=yolo11n.pt
SENTINEL_YOLO_CONFIDENCE=0.35
SENTINEL_HEARTBEAT_INTERVAL=30
SENTINEL_EVENT_BATCH_SIZE=10
SENTINEL_EVENT_FLUSH_INTERVAL=5
SENTINEL_QUEUE_MAX=1000
LOG_LEVEL=INFO
