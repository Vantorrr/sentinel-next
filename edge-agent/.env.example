# ── Sentinel Edge Agent Configuration ─────────────────────
# API key from the admin panel (required)
SENTINEL_API_KEY=sk-your-tenant-api-key-here
# Central server URL
SENTINEL_API_URL=https://your-sentinel.railway.app
# Agent identity
SENTINEL_AGENT_ID=salon-1
SENTINEL_AGENT_NAME="Салон на Маросейке"
# Cameras: comma-separated RTSP URLs or device indices
SENTINEL_CAMERAS=rtsp://admin:pass@192.168.1.100:554/stream1,rtsp://admin:pass@192.168.1.101:554/stream1
# Inference settings
SENTINEL_FPS_INFERENCE=10
SENTINEL_YOLO_MODEL=yolo11n.pt
SENTINEL_YOLO_CONFIDENCE=0.35
# Sync intervals (seconds)
SENTINEL_HEARTBEAT_INTERVAL=30
SENTINEL_EVENT_BATCH_SIZE=10
SENTINEL_EVENT_FLUSH_INTERVAL=5
LOG_LEVEL=INFO
